PORT=3000
# Use 25 when running without Docker (needs root); docker-compose maps 25 -> 2525
SMTP_PORT=2525
AGENT_MAIL_TOKEN=generate-a-long-random-token-here
# Free domain pointing at this host, e.g. a DuckDNS subdomain
MAIL_DOMAIN=myagentmail.duckdns.org

# Persistent storage (Supabase). Omit both to use the in-memory store
# for local dev (data is lost on restart).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Address lifecycle: addresses idle longer than ADDRESS_TTL_HOURS are
# auto-purged by a sweep running every ADDRESS_SWEEP_MS. 0 disables the sweep.
ADDRESS_TTL_HOURS=72
ADDRESS_SWEEP_MS=1800000

# Rate limits (per rolling hour). 0 disables.
ADDRESS_CREATE_MAX_PER_HOUR=20
EMAILS_PER_ADDRESS_PER_HOUR=100

# Accounts: free self-serve signup (POST /api/accounts) and per-account
# address quota. SIGNUP_OPEN=0 makes signup master-token-only.
SIGNUP_OPEN=1
SIGNUP_PER_IP_PER_HOUR=5
SIGNUP_MAX_PER_HOUR=500
ADDRESS_QUOTA_PER_ACCOUNT=25

# DKIM signing for outbound mail (makes mail deliverable, not spam).
# Generate a key with:
#   openssl genrsa -out dkim.pem 2048
# then publish the matching TXT record from GET /api/dns.
DKIM_DOMAIN=
DKIM_SELECTOR=mail
# DKIM_PRIVATE_KEY=<contents of dkim.pem, newlines may be written as \n>
DMARC_POLICY=none
# Host other servers should MX to (defaults to MAIL_DOMAIN).
MX_HOST=

# Incoming-mail webhook (optional). Fired on every received email with an
# HMAC-SHA256 signature header X-AgentMail-Signature when the secret is set.
INCOMING_WEBHOOK_URL=
INCOMING_WEBHOOK_SECRET=
INCOMING_WEBHOOK_TIMEOUT_MS=8000

# Outbound SMTP relay: mail sent by POST /api/send goes through here.
# Without a relay host, /api/send answers 503. Port 465 uses implicit TLS,
# other ports use STARTTLS. USER/PASS are only needed if the relay requires
# auth (leave both unset for an open relay).
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=587
# SMTP_RELAY_USER=
# SMTP_RELAY_PASS=
# Max outbound sends per From address per rolling hour (0 disables).
SEND_MAX_PER_HOUR=100
