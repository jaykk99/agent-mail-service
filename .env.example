# Self-hosted Linux Plug-and-Play Configuration
# No secret variables or API keys are required.
PORT=3000
SMTP_PORT=2525
SMTP_HOST=0.0.0.0
SMTP_ENABLED=1
SMTP_ACCEPT_ANY_DOMAIN=1
MAIL_DOMAIN=agents.local
AGENT_COUNT=1000
DATA_DIR=./data
RETENTION_DAYS=30
DKIM_SELECTOR=mail
DMARC_POLICY=none
DIRECT_MX_OUTBOUND=1
LOCAL_POSTFIX_PORT=25