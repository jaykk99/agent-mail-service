PORT=3000
SMTP_PORT=2525
AGENT_MAIL_TOKEN=generate-a-long-random-token-here
MAIL_DOMAIN=mail.yourdomain.com

# Persistent storage (Supabase). Omit both to use the in-memory store
# for local dev (data is lost on restart).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Address lifecycle: addresses idle longer than ADDRESS_TTL_HOURS are
# auto-purged by a sweep running every ADDRESS_SWEEP_MS. 0 disables the sweep.
ADDRESS_TTL_HOURS=72
ADDRESS_SWEEP_MS=1800000

# Rate limits (per rolling hour). 0 disables.
ADDRESS_CREATE_MAX_PER_HOUR=20
EMAILS_PER_ADDRESS_PER_HOUR=100

# Incoming-mail webhook (optional). Fired on every received email with an
# HMAC-SHA256 signature header X-AgentMail-Signature when the secret is set.
INCOMING_WEBHOOK_URL=
INCOMING_WEBHOOK_SECRET=
INCOMING_WEBHOOK_TIMEOUT_MS=8000

# Outbound SMTP relay (optional, validated at boot; the service never sends
# mail today, validation exists so config mistakes fail loudly).
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=587
# SMTP_RELAY_USER=
# SMTP_RELAY_PASS=
