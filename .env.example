# Self-hosted Linux Plug-and-Play Configuration
# No third-party API keys are required for local operation.
# Default listeners are local-only. To allow LAN access, explicitly set
# SMTP_HOST to a trusted interface and secure the network and API first.
PORT=3000
SMTP_PORT=2525
SMTP_HOST=127.0.0.1
SMTP_ENABLED=1
SMTP_ACCEPT_ANY_DOMAIN=1
MAIL_DOMAIN=agents.local
AGENT_COUNT=1000
DATA_DIR=./data
RETENTION_DAYS=30
DKIM_SELECTOR=mail
DMARC_POLICY=none
DIRECT_MX_OUTBOUND=1
LOCAL_POSTFIX_PORT=25
